GOOGLE_API_KEY=

# Universal settings (see src/finance_qna/config.py)
# AGENT_ARCHITECTURE=langgraph   # or: monolithic, context_stuffing
# DB_PATH=data/synthetic_transactions.db

# LangGraph-architecture settings (see src/finance_qna/agent/langgraph_adapter.py)
# only relevant when AGENT_ARCHITECTURE=langgraph
# LANGGRAPH_AGENT_MODEL=gemini-3.5-flash-lite
# LANGGRAPH_CLASSIFIER_MODEL=gemini-3.5-flash-lite
# LANGGRAPH_MAX_TOOL_STEPS=6
# LANGGRAPH_GROUNDEDNESS_RETRY_LIMIT=1

# Monolithic ReAct architecture settings (see src/finance_qna/agent/monolithic_adapter.py)
# only relevant when AGENT_ARCHITECTURE=monolithic
# MONOLITHIC_MODEL=gemini-3.5-flash-lite
# MONOLITHIC_MAX_TOOL_STEPS=6

# Context-Stuffing architecture settings (see src/finance_qna/agent/context_stuffing_adapter.py)
# only relevant when AGENT_ARCHITECTURE=context_stuffing
# CONTEXT_STUFFING_MODEL=gemini-3.5-flash-lite
